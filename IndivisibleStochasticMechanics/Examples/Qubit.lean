module

public import IndivisibleStochasticMechanics.Quantum.UnitaryProcess

/-!
# A qubit whose stochastic process is indivisible

The simplest example of the stochastic-quantum correspondence. A two-configuration system
(`Fin 2`) evolves with the Hamiltonian `H = σₓ` (setting `ℏ = 1`), so

  `U t = exp(-i t σₓ) = !![cos t, -i sin t; -i sin t, cos t]`

and the induced transition matrix is

  `Γ t = !![cos² t, sin² t; sin² t, cos² t]`.

At `t = π/4` every column of `Γ` is `(1/2, 1/2)`: the system has completely "forgotten" its
initial configuration. Yet at `t = π/2` it has deterministically swapped configurations.
No stochastic law can recover that information from time `π/4` onward, so `π/4` is **not**
a division event and the process is **indivisible**. This is interference, seen from the
stochastic side.

## Main results

* `ISM.Qubit.process`: the process induced by `U`.
* `ISM.Qubit.process_Γ`: the explicit formula for `Γ t`.
* `ISM.Qubit.not_isDivisionEvent_pi_div_four`: `π/4` is not a division event.
* `ISM.Qubit.process_isIndivisible`: the process is indivisible.
-/

@[expose] public section

open Matrix Complex

namespace ISM

namespace Qubit

/-- Unitary evolution generated by `H = σₓ`: `U t = exp(-i t σₓ)`. -/
noncomputable def U (t : ℝ) : Matrix (Fin 2) (Fin 2) ℂ :=
  !![(Real.cos t : ℂ), -I * Real.sin t; -I * Real.sin t, Real.cos t]

theorem U_mem_unitaryGroup (t : ℝ) : U t ∈ Matrix.unitaryGroup (Fin 2) ℂ := by
  rw [Matrix.mem_unitaryGroup_iff']
  have h : (Real.cos t : ℂ) ^ 2 + (Real.sin t : ℂ) ^ 2 = 1 := by
    exact_mod_cast Real.cos_sq_add_sin_sq t
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [U, Matrix.mul_apply, Fin.sum_univ_two, -Complex.ofReal_cos, -Complex.ofReal_sin] <;>
    ring_nf <;> simp [Complex.I_sq]

theorem U_zero : U 0 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [U]

/-- The generalized stochastic process of the qubit. -/
noncomputable def process : GenStochasticProcess (Fin 2) :=
  GenStochasticProcess.ofUnitary U U_mem_unitaryGroup U_zero

/-- Explicit transition matrix: `Γ t = !![cos² t, sin² t; sin² t, cos² t]`. -/
theorem process_Γ (t : ℝ) :
    process.Γ t = !![Real.cos t ^ 2, Real.sin t ^ 2; Real.sin t ^ 2, Real.cos t ^ 2] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [process, U, -Complex.ofReal_cos, -Complex.ofReal_sin, Complex.norm_real]

/-- Time `π/4` is not a division event: after complete mixing, no stochastic law can
produce the deterministic swap observed at `π/2`. -/
theorem not_isDivisionEvent_pi_div_four : ¬ process.IsDivisionEvent (Real.pi / 4) := by
  rintro ⟨-, Δ, hΔ⟩
  have h := (hΔ (Real.pi / 2) (by linarith [Real.pi_pos])).2
  have h00 := congrFun (congrFun h 0) 0
  have h01 := congrFun (congrFun h 0) 1
  simp [process_Γ, Matrix.mul_apply, Fin.sum_univ_two] at h00 h01
  linarith

/-- The qubit process is indivisible. -/
theorem process_isIndivisible : process.IsIndivisible := fun h =>
  not_isDivisionEvent_pi_div_four (h _ (by positivity))

end Qubit

end ISM
